# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_PIN=43
CONFIG_ESP_CONSOLE_UART_RX_PIN=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_SDMMC_USE_SDIO_EXTENSIONS=y
CONFIG_FATFS_MAX_LUN=3
CONFIG_FATFS_SECTOR_SIZE=512
